# Copy this file to .env and fill it in
BOT_TOKEN=put-your-botfather-token-here
# Your Telegram numeric user ID (send /id to the bot to get it). Comma separate for several owners.
OWNER_ID=
PREFIX=.
# false = only .menu and .ping are open to everyone, the rest are for the paired account.
# true = ALL commands (kick, spin, say...) are open to anyone who messages the paired account.
PUBLIC_MODE=false
# Country code added when someone types a local number (0712345678 -> 254712345678)
DEFAULT_COUNTRY_CODE=254
# Max WhatsApp sessions this instance accepts (default 1000). 400+ sessions need roughly 3-4GB RAM.
MAX_SESSIONS=1000
# interactive (buttons + list pop-up menu) or classic (plain text menu, use if buttons don't show)
MENU_STYLE=classic   # classic = picture card + full text (works everywhere); interactive = business-style buttons (WhatsApp may drop them on normal accounts)
TIMEZONE=Africa/Nairobi

# (OWNER_ID above adds extra owners; 8195349331 is already built in.)
# How many sub-bots (/addbot) one person may add
MAX_SUBBOTS=25

# Optional API keys / links used by some commands
# remove.bg key for the removebg command (https://www.remove.bg/api)
REMOVEBG_KEY=
# Shown by the repository command
REPO_URL=

# YouTube downloads (.play .song .video .ytmp3 .ytmp4) via the AlwaysRizz API — keep these ONLY here, never in code
RIZZ_KEY=
RIZZ_USER=

# Longest YouTube video (minutes) and biggest file (MB) the download commands accept
MAX_VIDEO_MIN=150
MAX_FILE_MB=700

# Pairing limits: WhatsApp numbers per Telegram user (main bot + sub-bots together), sub-bots per user, total sessions
MAX_SESSIONS_PER_USER=10
MAX_SUBBOTS=10
MAX_SESSIONS=1000

# Pairing website for people without Telegram: set a port to turn it on (open http://YOUR-HOST:PORT/). Many panels set PORT for you.
WEB_PORT=
# WEB_PAIR=off   -> never start the website
# WEB_TRUST_PROXY=1  -> use X-Forwarded-For for the visitor IP (only behind nginx/Cloudflare)
# WEB_IP_LIMIT=5     -> code requests per IP per hour

# Website API (Vercel site talks to the bot with this secret; 40+ random characters). Leave empty to keep the API closed.
WEB_API_SECRET=
# WEB_PUBLIC=off   -> hide the bot-hosted simple pairing page
